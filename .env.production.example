COMPOSE_PROJECT_NAME=chatify-realtime
APP_ENV=production

POSTGRES_DB=chatify
POSTGRES_USER=chatify
POSTGRES_PASSWORD=replace-from-secret-manager

REDIS_PASSWORD=replace-from-secret-manager
REDIS_ADDRESS=redis:6379

HTTP_ADDRESS=:8080
DATABASE_URL=postgres://chatify:replace-from-secret-manager@postgres:5432/chatify?sslmode=disable
POSTGRES_ADDRESS=postgres:5432
REDPANDA_ADDRESS=redpanda:9092
JWT_SECRET=replace-with-at-least-32-random-characters-from-secret-manager
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters-from-secret-manager
COOKIE_SECURE=true
CORS_ORIGIN=https://app.example.com
WEB_API_URL=https://api.example.com
WEB_SIGNALING_URL=https://signal.example.com
WEB_MEDIA_URL=https://media.example.com
WEB_CSP_CONNECT_SRC=https://api.example.com https://signal.example.com wss://signal.example.com https://media.example.com
MEDIA_CORS_ORIGIN=https://app.example.com
API_RATE_LIMIT_MAX=300
API_MAX_BODY_BYTES=1048576

RUSTFS_ACCESS_KEY=replace-from-secret-manager
RUSTFS_SECRET_KEY=replace-from-secret-manager
RUSTFS_BUCKET=chatify
OBJECT_STORAGE_ENDPOINT=object-storage:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://objects.example.com

TURN_REALM=turn.example.com
TURN_SECRET=replace-from-secret-manager
RTC_STUN_URL=stun:turn.example.com:3478
RTC_TURN_URL=turn:turn.example.com:3478?transport=udp
RTC_TURN_USERNAME=replace-with-short-lived-credential
RTC_TURN_CREDENTIAL=replace-with-short-lived-turn-credential
RTC_ANNOUNCED_ADDRESS=media.example.com
