COMPOSE_PROJECT_NAME=chatify-realtime-local
APP_ENV=local

POSTGRES_DB=chatify
POSTGRES_USER=chatify
POSTGRES_PASSWORD=chatify-local-only-change-me

REDIS_PASSWORD=redis-local-only-change-me
REDIS_ADDRESS=redis:6379

# API container addresses (Docker Compose service DNS)
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://chatify:chatify-local-only-change-me@postgres:5432/chatify?sslmode=disable
POSTGRES_ADDRESS=postgres:5432
REDIS_ADDRESS=redis:6379
REDPANDA_ADDRESS=redpanda:9092
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
API_RATE_LIMIT_MAX=300
API_MAX_BODY_BYTES=1048576
OUTBOX_TOPIC=room-events
SIGNALING_PORT=3001
SIGNAL_RATE_LIMIT_MAX=240
CORS_ORIGIN=http://localhost:3000
WEB_API_URL=http://localhost:8080
WEB_SIGNALING_URL=http://localhost:3001
WEB_MEDIA_URL=http://localhost:3002
WEB_CSP_CONNECT_SRC=http://localhost:8080 http://localhost:3001 ws://localhost:3001 http://localhost:3002
MEDIA_CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://api:8080
MEDIA_HTTP_PORT=3002
MEDIA_TRANSPORT_IDLE_TIMEOUT_MS=60000
RTC_MIN_PORT=40000
RTC_MAX_PORT=40020
RTC_ANNOUNCED_ADDRESS=127.0.0.1
RTC_STUN_URL=stun:127.0.0.1:3478
RTC_TURN_URL=turn:127.0.0.1:3478?transport=udp
RTC_TURN_USERNAME=chatify
RTC_TURN_CREDENTIAL=turn-local-only-change-me

RUSTFS_ACCESS_KEY=CHATIFYLOCAL
RUSTFS_SECRET_KEY=rustfs-local-only-change-me
RUSTFS_BUCKET=chatify-local
OBJECT_STORAGE_ENDPOINT=object-storage:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

TURN_REALM=chatify.local
TURN_SECRET=turn-local-only-change-me
